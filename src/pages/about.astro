---
import BaseLayout from "@/layouts/BaseLayout.astro";
// import Button from "@/components/Button.astro";
import { SITE } from "@/site.config";

const tools = ["Cuts", "Trim", "Fades", "Community"];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} `}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">
      About
    </p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {SITE.role}.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>
        A fresh cut, a friendly face, and a place to feel at home. Come by
        Barbershop 26 in North Hollywood for a classic cut, a fresh fade, or
        just a good conversation. Grab a coffee, enjoy a cookie, and make
        yourself comfortable.
      </p>
      <p>
        <img
          src="/images/barbershop-26/barbershop-26-noho-logo.png"
          alt="Barbershop 26, NOHO"
        />
      </p>
      <p>
        <strong>OPEN HOURS</strong>
        <br />
        Sunday - Thursday 10:00 AM - 8:00 PM
        <br />
        Friday 10:00 AM - 2:00 PM
        <br />SAT CLOSED שבת
      </p>

      <p>
        <a href="https://maps.app.goo.gl/FQdhMzNbD8fxt1U56" target="_blank">
          Google maps
        </a>
      </p>
      <p>
        <a href="https://www.instagram.com/barbershop_26__/" target="_blank">
          Instagram
        </a>
      </p>
    </div>
    <div class="mt-10">
      <p
        class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase"
      >
        Services
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>
    <!-- <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button> -->
  </section>
</BaseLayout>
